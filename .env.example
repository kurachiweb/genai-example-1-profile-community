# ローカル開発用の環境変数サンプル。
# dev/prod のシークレットの正本は Wrangler Secrets / GitHub Actions Secrets であり、Docker 経由で本番シークレットを扱わない。

# docker compose のプロジェクト名（コンテナ/ネットワーク/ボリュームの接頭辞）。
COMPOSE_PROJECT_NAME=genai-example-1-profile-community

# メール送信（ローカルは Mailpit、本番は Amazon SES）。
# Mailpit の SMTP 受信ポート。送信メールは Web UI（http://localhost:48035）で確認する。
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025

# ローカル DB（apps/db の SQLite）。本番は Cloudflare D1 に置き換わる。
DATABASE_URL=file:/workspace/apps/db/.data/local.sqlite
