# ローカル開発用の環境変数サンプル。
# dev/prod のシークレットの正本は Wrangler Secrets / GitHub Actions Secrets であり、Docker 経由で本番シークレットを扱わない。

# docker compose のプロジェクト名（コンテナ/ネットワーク/ボリュームの接頭辞）。
COMPOSE_PROJECT_NAME=genai-example-1-profile-community

# メール送信（ローカルは Mailpit、本番は Amazon SES）。
# Mailpit の SMTP 受信ポート。送信メールは Web UI（http://localhost:48035）で確認する。
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_FROM=

# ローカル DB（db コンテナの SQLite）。本番は Cloudflare D1 に置き換わる。
# 各 DB 利用コンテナは db_data ボリュームを同一パス /workspace/.db-data で共有するため、
# DATABASE_URL もコンテナ非依存の同一パスを指す（compose.yaml の db/api/public-api volumes）。
DATABASE_URL=file:/workspace/.db-data/local.sqlite

# 利用者・管理者セッション/各種ワンタイムトークンの保存先（ローカルは Valkey、本番は Cloudflare KV）。
# api コンテナからは docker compose のサービス名で到達するため、通常は変更不要。
# ホスト側（コンテナ外）から接続する場合は redis://localhost:48036 を指定する。
VALKEY_URL=redis://valkey:6379

# Cloudflare アカウント API トークン
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=

# Amazon SES アクセスキー
AWS_DEFAULT_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# パスワードハッシュ化（PBKDF2）のペッパー。Cloudflare Workers の crypto.subtle が課す
# イテレーション数上限（100,000、BR-COMMON-003）を補う、DB とは独立した秘密鍵。
# 32文字以上必須（未設定・短すぎる場合は api の起動に失敗する）。
# 生成例: openssl rand -base64 32
# dev/prod は Wrangler Secrets（wrangler secret put PASSWORD_PEPPER）で管理し、.env の値は使わない。
PASSWORD_PEPPER=