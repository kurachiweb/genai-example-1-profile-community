{
	"name": "@app/api",
	"version": "0.0.0",
	"private": true,
	"description": "内部 GraphQL API（NestJS + Apollo Server / クリーンアーキテクチャ）",
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"seed": "ts-node -r tsconfig-paths/register src/infrastructure/seed.ts",
		"seed:admin": "ts-node -r tsconfig-paths/register src/infrastructure/seed-admin.ts",
		"migration:create": "ts-node -r tsconfig-paths/register src/infrastructure/migration-cli.ts create",
		"migration:up": "ts-node -r tsconfig-paths/register src/infrastructure/migration-cli.ts up",
		"migration:down": "ts-node -r tsconfig-paths/register src/infrastructure/migration-cli.ts down",
		"migration:export-wrangler": "ts-node -r tsconfig-paths/register scripts/export-wrangler-migration.ts",
		"mikro-orm:compile": "DATABASE_URL=:memory: mikro-orm compile --config ./src/infrastructure/mikro-orm.config.ts",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"dev:worker": "pnpm build && wrangler dev --env dev",
		"deploy:worker": "pnpm build && wrangler deploy --env dev",
		"lint": "eslint \"{src,test,scripts,migrations}/**/*.ts\"",
		"lint:fix": "eslint \"{src,test,scripts,migrations}/**/*.ts\" --fix",
		"format": "prettier --write \"{src,test,scripts,migrations}/**/*.ts\"",
		"format:check": "prettier --check \"{src,test,scripts,migrations}/**/*.ts\""
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@mikro-orm/core": "^7.1.5",
		"@mikro-orm/migrations": "^7.1.5",
		"@mikro-orm/nestjs": "^7.0.2",
		"@mikro-orm/sqlite": "^7.1.5",
		"@nestjs/apollo": "^13.4.2",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/graphql": "^13.4.2",
		"@nestjs/platform-express": "^11.1.27",
		"@simplewebauthn/server": "^13.3.1",
		"@types/express": "^5.0.6",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dataloader": "^2.2.3",
		"express": "^5.2.1",
		"graphql": "^17.0.0",
		"hash-wasm": "^4.12.0",
		"ioredis": "^5.11.1",
		"kysely": "^0.29.2",
		"kysely-d1": "^0.4.0",
		"nodemailer": "^9.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260705.1",
		"@eslint/js": "^10.0.1",
		"@mikro-orm/cli": "^7.1.5",
		"@nestjs/cli": "^11.0.23",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.27",
		"@types/ioredis-mock": "^8.2.7",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.0",
		"@types/nodemailer": "^8.0.1",
		"@types/supertest": "^7.2.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"ioredis-mock": "^8.13.1",
		"jest": "^30.4.2",
		"jiti": "^2.7.0",
		"prettier": "^3.8.4",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	}
}
