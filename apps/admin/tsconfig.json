{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["dom", "dom.iterable", "es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"incremental": true,
		"noEmit": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"],
			"@lib/*": ["./lib/*"],
			"@lib": ["./lib"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "eslint.config.ts"]
}
