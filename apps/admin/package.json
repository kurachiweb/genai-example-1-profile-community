{
  "name": "@app/admin",
  "version": "0.0.0",
  "private": true,
  "description": "管理者コンソール Web（Next.js / App Router・BFF）。内部 GraphQL(api)をサーバー側で呼ぶ。",
  "scripts": {
    "dev": "next dev -p 48033",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 48033",
    "build:cloudflare": "opennextjs-cloudflare build --env dev",
    "preview:cloudflare": "opennextjs-cloudflare build --env dev && opennextjs-cloudflare preview --env dev",
    "deploy:cloudflare": "opennextjs-cloudflare build --env dev && opennextjs-cloudflare deploy --env dev",
    "deploy:cloudflare:prod": "opennextjs-cloudflare build --env prod && opennextjs-cloudflare deploy --env prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,app}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,app}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{src,app}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,app}/**/*.{ts,tsx,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@app/frontend-lib": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@simplewebauthn/browser": "^13.3.0",
    "lucide-react": "^1.18.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.0.4",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "wrangler": "^4.107.0"
  }
}
