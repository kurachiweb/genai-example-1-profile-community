{
	"name": "@app/public-api",
	"version": "0.0.0",
	"private": true,
	"description": "公開 REST API（NestJS / クリーンアーキテクチャ・API キー認証・レート制限・OpenAPI）",
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"seed": "ts-node -r tsconfig-paths/register src/infrastructure/seed.ts",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint \"{src,test}/**/*.ts\"",
		"lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
	},
	"dependencies": {
		"@mikro-orm/core": "^7.1.4",
		"@mikro-orm/nestjs": "^7.0.2",
		"@mikro-orm/sqlite": "^7.1.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/platform-express": "^11.1.27",
		"@nestjs/swagger": "^11.4.4",
		"@nestjs/throttler": "^6.5.0",
		"class-transformer": "^0.5.1",
		"dataloader": "^2.2.3",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^11.0.23",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.27",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.0",
		"@types/supertest": "^7.2.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"jest": "^30.4.2",
		"jiti": "^2.7.0",
		"prettier": "^3.8.4",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	}
}
