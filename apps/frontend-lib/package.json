{
  "name": "@app/frontend-lib",
  "version": "0.0.0",
  "private": true,
  "description": "フロントエンド共通ファイル（デザイントークン・ユーティリティ・コンポーネント）。client/admin で再利用する。",
  "type": "module",
  "exports": {
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/global.css": "./styles/global.css",
    "./utilities/*": "./utilities/*.ts",
    "./components/*": "./components/*.tsx",
    ".": "./index.ts"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{components,utilities}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{components,utilities}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{components,utilities,styles}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{components,utilities,styles}/**/*.{ts,tsx,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
